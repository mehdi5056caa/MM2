local function createPage(name)
    local page = Instance.new("Frame")
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, -30, 1, -50)
    page.Position = UDim2.new(0, 15, 0, 40)
    page.BackgroundTransparency = 1
    page.Visible = false
