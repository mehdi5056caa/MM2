-- 1. Get Player Role Function
local function getPlayerRole(plr)
    if not plr or not plr.Character then return "Innocent", Color3.fromRGB(0, 255, 120) end
    
    -- Check Backpack & Character Tools
    local character = plr.Character
    local backpack = plr:FindFirstChild("Backpack")

    local function hasItem(itemName)
        return (character and character:FindFirstChild(itemName)) or (backpack and backpack:FindFirstChild(itemName))
    end

    if hasItem("Knife") then
        return "Murderer", Color3.fromRGB(255, 30, 30)
    elseif hasItem("Gun") then
        return "Sheriff", Color3.fromRGB(30, 140, 255)
    end

    return "Innocent", Color3.fromRGB(0, 255, 120)
end

-- 2. ESP Engine (Line + Highlight + Label)
RunService.RenderStepped:Connect(function()
    if not State.ESP_Players then
        ESPFolder:ClearAllChildren()
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            local role, color = getPlayerRole(plr)

            -- Highlight
            local hl = ESPFolder:FindFirstChild("HL_" .. plr.Name)
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "HL_" .. plr.Name
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = ESPFolder
            end
            hl.Adornee = plr.Character
            hl.FillColor = color
            hl.FillTransparency = 0.4
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)

            -- Billboard Label
            local bb = ESPFolder:FindFirstChild("BB_" .. plr.Name)
            if not bb then
                bb = Instance.new("BillboardGui")
                bb.Name = "BB_" .. plr.Name
                bb.Size = UDim2.new(0, 140, 0, 30)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.AlwaysOnTop = true
                bb.Parent = ESPFolder

                local txt = Instance.new("TextLabel")
                txt.Name = "Title"
                txt.Size = UDim2.new(1, 0, 1, 0)
                txt.BackgroundTransparency = 1
                txt.Font = Enum.Font.GothamBlack
                txt.TextSize = 12
                txt.TextStrokeTransparency = 0
                txt.Parent = bb
            end
            bb.Adornee = hrp
            local title = bb:FindFirstChild("Title")
            if title then
                title.Text = plr.Name .. " [" .. role .. "]"
                title.TextColor3 = color
            end

            -- Line Tracer (Drawing API alternative using Billboard Vector)
            if State.ESP_Lines then
                local line = ESPFolder:FindFirstChild("Line_" .. plr.Name)
                if not line then
                    line = Instance.new("LineHandleAdornment")
                    line.Name = "Line_" .. plr.Name
                    line.Length = 0
                    line.Thickness = 2
                    line.AlwaysOnTop = true
                    line.Parent = ESPFolder
                end
                
                local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myHrp then
                    line.Adornee = myHrp
                    line.CFrame = CFrame.new(Vector3.new(0, -2, 0), hrp.Position - myHrp.Position)
                    line.Length = (hrp.Position - myHrp.Position).Magnitude
                    line.Color3 = color
                end
            end
        end
    end
end)

-- 3. SMART AIMBOT ENGINE
local function getAimbotTarget()
    local myRole = getPlayerRole(LocalPlayer)
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    
    local myPos = myChar.HumanoidRootPart.Position
    local closestPlr = nil
    local shortestDist = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local role = getPlayerRole(plr)
            local hrp = plr.Character.HumanoidRootPart
            local dist = (hrp.Position - myPos).Magnitude

            if myRole == "Sheriff" or myChar:FindFirstChild("Gun") then
                -- Sheriff/Hero Target ONLY Murderer
                if role == "Murderer" then
                    return hrp
                end
            elseif myRole == "Murderer" or myChar:FindFirstChild("Knife") then
                -- Murderer Targets EVERYONE (Closest first)
                if dist < shortestDist then
                    shortestDist = dist
                    closestPlr = hrp
                end
            end
        end
    end

    return closestPlr
end

-- Aimbot Lock Loop
RunService.RenderStepped:Connect(function()
    if State.Aimbot_Enabled then
        local myChar = LocalPlayer.Character
        local isHoldingWeapon = myChar and (myChar:FindFirstChild("Gun") or myChar:FindFirstChild("Knife"))

        if isHoldingWeapon or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local targetHrp = getAimbotTarget()
            if targetHrp then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHrp.Position)
            end
        end
    end
end)

-- 4. FLY ENGINE
local bodyVelocity, bodyGyro = nil, nil
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char.HumanoidRootPart

        if State.Fly then
            if not bodyVelocity or bodyVelocity.Parent ~= hrp then
                bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                bodyVelocity.Parent = hrp
            end

            if not bodyGyro or bodyGyro.Parent ~= hrp then
                bodyGyro = Instance.new("BodyGyro")
                bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                bodyGyro.P = 9000
                bodyGyro.Parent = hrp
            end

            local moveDir = hum.MoveDirection
            local verticalDir = 0

            if UserInputService:IsKeyDown(Enum.KeyCode.E) then verticalDir = 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then verticalDir = -1 end

            bodyVelocity.Velocity = (moveDir * State.FlySpeed) + Vector3.new(0, verticalDir * (State.FlySpeed * 0.75), 0)
            bodyGyro.CFrame = Camera.CFrame
        else
            if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
            if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
        end
    end
end)

-- Dragging & Hide Key
local Dragging, DragStart, StartPos
Sidebar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = input.Position
        StartPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then Dragging = false end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - DragStart
        MainFrame.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == State.ToggleKey then
        State.MenuVisible = not State.MenuVisible
        MainFrame.Visible = State.MenuVisible
    end
end)

