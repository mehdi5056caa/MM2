    Pages[name] = page
    return page
end

local function createTabButton(name, icon)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    btn.Text = "   " .. icon .. "  " .. name
    btn.TextColor3 = Color3.fromRGB(160, 160, 175)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = NavList

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        for tabName, p in pairs(Pages) do
            if tabName == name then
                p.Visible = true
                TabButtons[tabName].BackgroundColor3 = Color3.fromRGB(35, 35, 48)
                TabButtons[tabName].TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                p.Visible = false
                TabButtons[tabName].BackgroundColor3 = Color3.fromRGB(18, 18, 24)
                TabButtons[tabName].TextColor3 = Color3.fromRGB(160, 160, 175)
            end
        end
    end)

    TabButtons[name] = btn
end

